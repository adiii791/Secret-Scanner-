# .ebextensions/02_security.config
# Security-hardening headers and HTTPS redirect at the load balancer level.
# Requires an HTTPS listener on your ALB (add SSL cert via ACM).

option_settings:
  # Redirect HTTP → HTTPS at the load balancer (Application Load Balancer).
  # Add this after you attach an ACM certificate to your HTTPS listener.
  aws:elbv2:listener:443:
    Protocol: HTTPS
    SSLCertificateArns: "arn:aws:acm:REGION:ACCOUNT_ID:certificate/CERT_ID"
    DefaultProcess: default
    Rules: "default"

  aws:elbv2:listener:80:
    Protocol: HTTP
    DefaultProcess: redirect
    Rules: "default"

  aws:elbv2:listenerrule:redirect:
    PathPatterns: "/*"
    Process: redirect
    Priority: "1"

  aws:elasticbeanstalk:environment:process:redirect:
    Protocol: HTTP
    Port: "80"
