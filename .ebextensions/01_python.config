# .ebextensions/01_python.config
# Elastic Beanstalk — Python platform hooks
# This file runs on every deployment. Keep commands idempotent.

option_settings:
  # Point EB's WSGI runner at our wsgi.py entry point.
  aws:elasticbeanstalk:container:python:
    WSGIPath: wsgi:app
    NumProcesses: 1
    NumThreads: 15

  # Environment variables safe to commit (non-secret).
  # Secrets (JWT_SECRET_KEY, DATABASE_URL, etc.) must be set via
  # the EB console → Configuration → Software → Environment properties,
  # or via AWS Secrets Manager / Parameter Store.
  aws:elasticbeanstalk:application:environment:
    FLASK_DEBUG: "false"
    GUNICORN_LOG_LEVEL: "info"
    AUTO_CREATE_DB: "false"

  # Health-check path — EB/ALB pings this to decide if instances are healthy.
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /api/health
    MatcherHTTPCode: "200"

  # Enhanced health reporting.
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced

  # Rolling deployments — never take all instances out of rotation at once.
  aws:elasticbeanstalk:command:
    DeploymentPolicy: Rolling
    BatchSizeType: Percentage
    BatchSize: "50"

container_commands:
  # Run database migrations after the new app version is deployed but
  # before traffic is switched to the new instances.
  01_db_migrate:
    command: "cd backend && flask --app app db upgrade"
    leader_only: true
