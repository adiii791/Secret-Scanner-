# ============================================================
# SecretScanner v2.0 — Environment Variables
# ============================================================

# JWT Secret Key — used to sign login tokens
# Change this to any long random string
JWT_SECRET_KEY=replace-with-a-random-jwt-secret

# Database URL — SQLite for local development
DATABASE_URL=postgresql://postgres:database-password@localhost:5432/secretscanner

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=True

# App Port
PORT=5001

# The only account allowed to access /admin.html and /api/admin/database.
# Set this to the email address you use to register.
ADMIN_EMAIL=goreaadesh791@gmail.com
            sadawarteavani@gmail.com

# GitHub Webhook Secret 
GITHUB_WEBHOOK_SECRET=replace-with-webhook-secret
GITHUB_TOKEN=github_token_placeholder
