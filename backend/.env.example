# ============================================================
# Secret Scanner — LOCAL DEVELOPMENT environment
# ============================================================
# 1. Copy this file:  cp backend/.env.example backend/.env
# 2. Run the app:     cd backend && python app.py
# ============================================================

# ---- Required (dev defaults work out of the box) ----------

# Any 32+ char string. Change this to something random for real use.
JWT_SECRET_KEY=dev-local-secret-key-change-me-before-prod

# SQLite — no database server needed for local dev.
DATABASE_URL=sqlite:///secretscanner.db

# ---- Server ------------------------------------------------

FLASK_DEBUG=true
PORT=5000
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# ---- Database bootstrap ------------------------------------

# true = auto-create tables on startup (dev only, no migrations needed)
AUTO_CREATE_DB=true

# ---- Optional (leave blank for local dev) ------------------

ADMIN_EMAIL=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=
OTP_DEMO_MODE=true
