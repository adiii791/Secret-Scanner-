# ============================================================
# Secret Scanner — Environment Variables
# ============================================================
# Copy this file to backend/.env for local development.
# In AWS: set these values via EB Console / ECS Task Definition /
#         AWS Secrets Manager / Parameter Store — never commit real values.
# ============================================================

# ---- Required -----------------------------------------------

# JWT signing key — minimum 32 random characters.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# PostgreSQL connection string (psycopg v3 driver).
# Local SQLite fallback (dev only): sqlite:///secretscanner.db
DATABASE_URL=postgresql+psycopg://user:password@host:5432/secretscanner

# ---- Server --------------------------------------------------

FLASK_DEBUG=false
PORT=5000

# Comma-separated list of allowed CORS origins (exact HTTPS URLs in prod).
# Example: https://secretscanner.example.com
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# ---- Admin ---------------------------------------------------

# Email address(es) granted admin access to /api/admin/database.
# Comma-separated for multiple admins.
ADMIN_EMAIL=you@example.com

# ---- Database bootstrap (dev only) --------------------------

# Set to true only once to auto-create tables (instead of running migrations).
# Always false in production; use: flask --app backend/app db upgrade
AUTO_CREATE_DB=false

# ---- GitHub Webhook ------------------------------------------

# Secret configured in GitHub repo → Settings → Webhooks.
GITHUB_WEBHOOK_SECRET=

# Personal access token for scanning private repos via webhook.
GITHUB_TOKEN=

# ---- SMTP / Email alerts  ------------------------------------

SMTP_SERVER=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=

# ---- OTP / Phone (optional feature) -------------------------

# Set to true in local dev to skip real SMS/email delivery.
OTP_DEMO_MODE=false
